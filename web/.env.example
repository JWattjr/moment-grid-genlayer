NEXT_PUBLIC_API_URL=
# localnet, studionet, or testnet-bradbury. Built-in RPCs are used when URL is blank.
NEXT_PUBLIC_GENLAYER_NETWORK=studionet
NEXT_PUBLIC_GENLAYER_RPC_URL=
NEXT_PUBLIC_GENLAYER_RESOLVER_ADDRESS=0x3a87Ee9a47f6B1d9d2298166a4a7cA4907780dd9
NEXT_PUBLIC_GENLAYER_RESOLUTION_ID=epl-2023-05-02-arsenal-chelsea-home-first
# Optional server-only fallback history for contracts deployed before enumeration support.
GENLAYER_HISTORY_IDS=epl-2023-05-02-arsenal-chelsea-home-first,epl-2023-05-02-arsenal-chelsea-penalty-30-60
# Optional explorer link template. Use {hash} where the transaction hash belongs.
NEXT_PUBLIC_GENLAYER_TX_URL_TEMPLATE=

NEXT_PUBLIC_REPLAY_SECONDS=120
